{% extends 'base.html.twig' %}

{% block title %}T index{% endblock %}

{% block body %}
    <h1>T index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Desc_event</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for t in ts %}
            <tr>
                <td>{{ t.id }}</td>
                <td>{{ t.name }}</td>
                <td>{{ t.descEvent }}</td>
                <td>
                    <a href="{{ path('app_t_show', {'id': t.id}) }}">show</a>
                    <a href="{{ path('app_t_edit', {'id': t.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_t_new') }}">Create new</a>
{% endblock %}
