{% extends 'base.html.twig' %}

{% block title %}Show Type{% endblock %}

{% block body %}
    <h1>Type Details</h1>

    <table>
        <tr>
            <th>Id</th>
            <td>{{ type.id }}</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>{{ type.name }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ type.descEvent }}</td>
        </tr>
    </table>

    <a href="{{ path('app_type_edit', {'id': type.id}) }}" class="btn btn-warning">Edit</a>
    <a href="{{ path('app_type_index') }}" class="btn btn-secondary">Back to list</a>
{% endblock %}