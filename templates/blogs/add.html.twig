{% extends 'blogs/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .create-blog-section {
            padding: 50px 0;
            background-color: rgba(240, 240, 240, 0.9);
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .create-blog-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        }

        .create-blog-card .card-title {
            font-size: 2rem;
            color: white;
            margin-bottom: 20px;
            background-color: #007BFF; /* Couleur bleue pour le titre */
            padding: 10px;
            border-radius: 5px;
            display: inline-block;
        }

        .create-blog-form {
            margin-top: 20px;
        }

        .create-blog-form .form-group {
            margin-bottom: 1.5rem;
        }

        .create-blog-form label {
            font-weight: bold;
            color: #333;
        }

        .create-blog-form input,
        .create-blog-form select,
        .create-blog-form textarea {
            border: 1px solid #ced4da;
            border-radius: 5px;
            padding: 10px;
            font-size: 1rem;
            width: 100%;
        }

        .create-blog-form button {
            background-color: #007BFF;
            border: none;
            padding: 10px 20px;
            font-size: 1.2rem;
            border-radius: 5px;
            transition: background-color 0.3s;
            color: white;
        }

        .create-blog-form button:hover {
            background-color: #0056b3;
        }
    </style>
{% endblock %}

{% block body %}
<section class="create-blog-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card create-blog-card">
                    <div class="card-body">
                        <h1 class="card-title text-center">Créer un blog</h1>
                        {{ form_start(form, {'attr': {'class': 'create-blog-form'}}) }}
                            {% for child in form %}
                                <div class="form-group">
                                    {{ form_label(child, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            {% endfor %}
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}