{% extends 'blogs/base.html.twig' %}

{% block body %}
    <h1>Recherche de Blogs</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Rechercher</button>
    {{ form_end(form) }}

    <hr>

    <h2>Résultats</h2>
    {% if results is empty %}
        <p>Aucun résultat trouvé.</p>
    {% else %}
        <ul>
            {% for blog in results %}
                <li>{{ blog.titre }} - {{ blog.descr }} - {{ blog.dateCrea|date('Y-m-d') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}