<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Liste des Blogs</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #ddd;
        }
    </style>
</head>
<body>
    <h1>Liste des Blogs</h1>
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date de Création</th>
                <th>Nombre de Likes</th>
            </tr>
        </thead>
        <tbody>
            {% for blog in blogs %}
                <tr>
                    <td>{{ blog.titre }}</td>
                    <td>{{ blog.dateCrea|date('Y-m-d') }}</td>
                    <td>{{ blog.likes }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>