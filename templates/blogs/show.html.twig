{% extends 'blogs/base.html.twig' %}

{% block body %}
    <h1>Détails du blog</h1>
    <p><strong>Titre:</strong> {{ blog.titre }}</p>
    <p><strong>Description:</strong> {{ blog.Descr }}</p>
    <p><strong>Commentaires:</strong></p>
    {{ form_start(form, {'method': 'POST'}) }}
    <div class="form-group text-center">
        {{ form_widget(form.content, {'attr': {'class': 'form-control', 'placeholder': 'Ajouter un commentaire...'}}) }}
        <button type="submit" class="btn btn-primary"><i class="fas fa-comment"></i></button>
    </div>
    {{ form_end(form) }}
    <ul>
        {% for comment in blog.comments %}
            <li>
                {{ comment.content }} - <span class="badge badge-pill badge-info"><i class="fas fa-clock"></i> {{ comment.createdAt|date('d-m-Y') }}</span>
                <form action="{{ path('app_deleteComment', {'id': comment.id}) }}" method="POST" style="display:inline;">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                </form>
                <form action="{{ path('app_reportComment', {'id': comment.id}) }}" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-warning btn-sm">
                        <i class="fas fa-flag"></i>
                    </button>
                </form>
                {% if comment.isIsReported() %}
                    <span class="badge badge-pill badge-danger">Signalé</span>
                    <ul>
                        {% for word in comment.getInappropriateWords(inappropriateWords) %}
                            <li class="text-danger">{{ word }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    <span class="badge badge-pill badge-info">
        <i class="fas fa-clock"></i> {{ blog.DateCrea|date('d-m-Y') }}
    </span>
    <span class="badge badge-pill badge-info">
        <i class="fas fa-clock"></i> {{ blog.DatePub|date('d-m-Y') }}
    </span>
    <p><strong>Types:</strong>
        <ul>
            {% for typeB in blog.typeBs %}
                <li>{{ typeB.libelle }}</li>
            {% else %}
                <li>No types found</li>
            {% endfor %}
        </ul>
    </p>
    <form action="{{ path('app_blogLike', {'id': blog.id}) }}" method="POST" style="display:inline;">
        <button type="submit" class="btn btn-success btn-sm">
            <i class="fas fa-thumbs-up"></i> Aimer ({{ blog.likes }})
        </button>
    </form>
    <a href="{{ path('app_blogsList') }}">Retour à la liste</a>

    <style>
        /* Style général pour la page */
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 0;
        }

        /* Style pour le conteneur principal */
        .container {
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        /* Style pour le titre */
        h1 {
            font-size: 2.5em;
            color: #2c3e50;
            text-align: center;
            margin-bottom: 20px;
            font-family: 'Playfair Display', serif;
        }

        /* Style pour les paragraphes */
        p {
            font-size: 1.2em;
            color: #34495e;
            margin: 10px 0;
        }

        /* Style pour les étiquettes */
        strong {
            font-weight: bold;
            color: #2c3e50;
        }

        /* Style pour le lien de retour */
        a {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 1.2em;
            color: #fff;
            background-color: #3498db;
            border-radius: 4px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        a:hover {
            background-color: #2980b9;
        }
    </style>
{% endblock %}