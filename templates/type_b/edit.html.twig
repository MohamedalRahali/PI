{% extends 'type_b/base.html.twig' %}

{% block body %}
    <h1>Modifier le type</h1>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Mettre à jour</button>
    {{ form_end(form) }}

    <style>
        /* Style général pour la page */
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 0;
        }

        /* Style pour le conteneur principal */
        .container {
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        /* Style pour le titre */
        h1 {
            font-size: 2.5em;
            color: #2c3e50;
            text-align: center;
            margin-bottom: 20px;
            font-family: 'Playfair Display', serif;
        }

        /* Style pour le formulaire */
        form {
            display: flex;
            flex-direction: column;
        }

        /* Style pour les champs du formulaire */
        .form-widget {
            margin-bottom: 15px;
        }

        label {
            font-size: 1.2em;
            color: #34495e;
            margin-bottom: 5px;
            display: block;
        }

        input, select, textarea {
            padding: 10px;
            font-size: 1em;
            border: 1px solid #bdc3c7;
            border-radius: 4px;
            width: 100%;
            box-sizing: border-box;
            transition: border-color 0.3s ease;
        }

        input:focus, select:focus, textarea:focus {
            border-color: #3498db;
            outline: none;
        }

        /* Style pour le bouton de soumission */
        button[type="submit"] {
            padding: 10px 20px;
            font-size: 1.2em;
            color: #fff;
            background-color: #e74c3c;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin-top: 20px;
            align-self: center;
        }

        button[type="submit"]:hover {
            background-color: #c0392b;
        }

        /* Style pour les messages d'erreur */
        .form-error {
            color: #e74c3c;
            font-size: 0.9em;
            margin-top: 5px;
        }
    </style>
{% endblock %}
