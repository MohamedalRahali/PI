{% extends 'base.html.twig' %}

{% block title %}Welcome{% endblock %}

{% block body %}
<h2>Blogs Populaires</h2>
<ul>
    {% for blog in blogs %}
        <li>
            <a href="{{ path('app_showBlog', {'id': blog.id}) }}">{{ blog.titre }}</a>
            <span class="badge badge-info">{{ blog.likes }} <i class="fas fa-thumbs-up"></i></span>
            <form action="{{ path('app_blogLike', {'id': blog.id}) }}" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="fas fa-thumbs-up"></i> Aimer
                </button>
            </form>
            <a href="{{ path('app_showBlog', {'id': blog.id}) }}" class="btn btn-primary btn-sm">
                <i class="fas fa-comment"></i> Commenter
            </a>
        </li>
    {% endfor %}
</ul>
{% endblock %}
