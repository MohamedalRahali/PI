{% extends 'evenment/baseevenement.html.twig' %}

{% block title %}Evenments{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-lg p-4">
            <h1 class="mb-4 text-center text-primary">
                <i class="fas fa-calendar-alt"></i> Liste des Événements
            </h1>

            <div class="evenment-list">
                <ul class="list-group">
                    {% for evenment in evenments %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="{{ path('evenment_show', {'id': evenment.id}) }}" class="text-decoration-none">
                                <i class="fas fa-calendar-day"></i> {{ evenment.title }}
                            </a>
                            <span class="badge badge-pill badge-info">
                                <i class="fas fa-clock"></i> {{ evenment.date|date('Y-m-d') }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <a href="{{ path('evenment_new') }}" class="btn btn-success mt-4 d-block mx-auto">
                <i class="fas fa-plus-circle"></i> Créer un nouvel événement
            </a>
        </div>
    </div>

    {# Ajout de styles personnalisés #}
    <style>
        .list-group-item {
            font-size: 18px;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .list-group-item a {
            color: #007bff;
            font-weight: bold;
            font-size: 16px;
        }

        .list-group-item a:hover {
            text-decoration: underline;
        }

        .badge {
            font-size: 14px;
        }

        .btn-success {
            font-size: 18px;
            text-align: center;
        }

        .btn-success i {
            margin-right: 10px;
        }
    </style>

    {# Ajout de FontAwesome pour les icônes #}
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
{% endblock %}
