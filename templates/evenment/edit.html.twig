{% extends 'evenment/baseevenement.html.twig' %}

{% block title %}Edit Evenment{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-lg p-4">
            <h1 class="mb-4 text-center text-primary">
                <i class="fas fa-edit"></i> Modifier l'événement
            </h1>

            <div class="form-container">
                {{ form_start(form, { 'attr': {'onsubmit': 'return validateForm()'} }) }}
                    <div class="form-group">
                        <label for="title" class="form-label">
                            <i class="fas fa-heading"></i> Titre de l'événement
                        </label>
                        {{ form_widget(form.title, { 'attr': {'class': 'form-control', 'oninput': 'validateField(this)', 'data-min-length': 4} }) }}
                        <div class="valid-feedback">✅ Correct</div>
                        <div class="invalid-feedback">❌ Title must be at least 5 characters long</div>
                    </div>

                    <div class="form-group">
                        <label for="date" class="form-label">
                            <i class="fas fa-calendar-day"></i> Date de l'événement
                        </label>
                        {{ form_widget(form.date, { 'attr': {'class': 'form-control'} }) }}
                        <div class="valid-feedback">✅ Correct</div>
                        <div class="invalid-feedback">❌ {{ form_errors(form.date) }}</div>
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">
                            <i class="fas fa-info-circle"></i> Description
                        </label>
                        {{ form_widget(form.description, { 'attr': {'class': 'form-control', 'oninput': 'validateField(this)', 'data-min-length': 4} }) }}
                        <div class="valid-feedback">✅ Correct</div>
                        <div class="invalid-feedback">❌ Description must be at least 5 characters long</div>
                    </div>

                    <div class="form-group">
                        <label for="lieux" class="form-label">
                            <i class="fas fa-map-marker-alt"></i> Lieux
                        </label>
                        {{ form_widget(form.lieux, { 'attr': {'class': 'form-control', 'oninput': 'validateField(this)', 'data-min-length': 4} }) }}
                        <div class="valid-feedback">✅ Correct</div>
                        <div class="invalid-feedback">❌ Location must be at least 5 characters long</div>
                    </div>

                    <div class="form-group text-center">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Sauvegarder
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>

            <div class="form-container mt-4">
                <a href="{{ path('evenment_index') }}" class="back-link text-center">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>
    </div>

    {# Ajouter des styles personnalisés #}
    <style>
        .card {
            border-radius: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .back-link {
            text-decoration: none;
            color: #007bff;
            font-size: 16px;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .form-container .btn {
            width: 100%;
        }

        .form-container {
            margin-top: 20px;
        }
    </style>

    {# Ajout de FontAwesome pour les icônes #}
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

    <script>
        function validateField(field) {
            const minLength = field.getAttribute('data-min-length');
            if (field.value.length > minLength) {
                field.classList.remove('is-invalid');
                field.classList.add('is-valid');
            } else {
                field.classList.remove('is-valid');
                field.classList.add('is-invalid');
            }
        }

        function validateForm() {
            const fields = document.querySelectorAll('[data-min-length]');
            let isValid = true;
            fields.forEach(field => {
                validateField(field);
                if (field.classList.contains('is-invalid')) {
                    isValid = false;
                }
            });
            return isValid;
        }
    </script>
{% endblock %}
