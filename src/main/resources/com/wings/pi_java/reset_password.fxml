<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.ResetPasswordController"
            prefWidth="400" prefHeight="500" 
            style="-fx-background-color: linear-gradient(to bottom right, #2d1f17, #4d3428);">
    
    <VBox alignment="CENTER" spacing="20" 
          AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" 
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20">

        <Label text="🔑 Reset Password" 
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;">
            <effect>
                <DropShadow color="#00000080" radius="5.0" spread="0.1"/>
            </effect>
        </Label>

        <VBox spacing="15" alignment="CENTER" prefWidth="300">
            <Label text="Enter the reset code and your new password" 
                   style="-fx-text-fill: white; -fx-wrap-text: true; -fx-alignment: center;"/>
            
            <TextField fx:id="codeField" promptText="Reset Code" 
                   style="-fx-background-radius: 10; -fx-padding: 8; -fx-background-color: white; -fx-text-fill: black;"/>

            <PasswordField fx:id="newPasswordField" promptText="New Password"
                      style="-fx-background-radius: 10; -fx-padding: 8; -fx-background-color: white; -fx-text-fill: black;"/>

            <PasswordField fx:id="confirmPasswordField" promptText="Confirm New Password"
                      style="-fx-background-radius: 10; -fx-padding: 8; -fx-background-color: white; -fx-text-fill: black;"/>

            <Button text="Reset Password" onAction="#resetPassword"
                    style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20;">
                <effect>
                    <DropShadow color="#00000080" radius="5.0" spread="0.1"/>
                </effect>
            </Button>

            <Button text="Back to Login" onAction="#goBackToLogin"
                    style="-fx-background-color: #4d3428; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20;">
                <effect>
                    <DropShadow color="#00000080" radius="5.0" spread="0.1"/>
                </effect>
            </Button>
        </VBox>
    </VBox>
</AnchorPane> 