<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.scene.paint.Color?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.UserViewController" prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to bottom right, #2d1f17, #4d3428);">
    <children>
        <!-- Header with title -->
        <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="20.0">
            <Label text="👤 User Management"
                   style="-fx-text-fill: #f9c89b;">
                <font>
                    <Font name="Georgia Bold" size="28.0"/>
                </font>
                <effect>
                    <DropShadow color="#00000080" radius="5.0" spread="0.1"/>
                </effect>
            </Label>
        </HBox>

        <!-- Search and filters -->
        <HBox alignment="CENTER" spacing="15" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="70.0">
            <TextField fx:id="searchField" promptText="Search users..." 
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: rgba(255, 255, 255, 0.9);
                             -fx-background-radius: 20px;
                             -fx-prompt-text-fill: #a0522d;
                             -fx-font-size: 14px;
                             -fx-padding: 8px 15px;">
                <effect>
                    <DropShadow color="#00000040" radius="4.0" spread="0.05"/>
                </effect>
            </TextField>
            <ChoiceBox fx:id="sortChoiceBox" HBox.hgrow="NEVER">
                <style>
                    -fx-background-color: white;
                    -fx-background-radius: 5;
                    -fx-padding: 8;
                    -fx-font-size: 14px;
                    -fx-min-width: 200;
                </style>
            </ChoiceBox>
        </HBox>

        <!-- List container -->
        <AnchorPane AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="120.0" AnchorPane.bottomAnchor="90.0"
                    style="-fx-background-color: rgba(160, 82, 45, 0.2);
                          -fx-background-radius: 15px;
                          -fx-border-color: #d3a27f;
                          -fx-border-width: 2px;
                          -fx-border-radius: 15px;">

            <!-- User list with enhanced style -->
            <ListView fx:id="userList" AnchorPane.topAnchor="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0"
                     style="-fx-background-color: rgba(255, 255, 255, 0.1);
                           -fx-border-color: transparent;
                           -fx-control-inner-background: rgba(255, 255, 255, 0.1);
                           -fx-selection-bar: #a0522d;
                           -fx-selection-bar-non-focused: #8b4513;
                           -fx-cell-size: 120px;
                           -fx-padding: 5px;">
                <effect>
                    <InnerShadow color="#00000040" radius="4.0" choke="0.1"/>
                </effect>
            </ListView>
        </AnchorPane>

        <!-- Action buttons -->
        <HBox alignment="CENTER" spacing="10" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="20.0">
            <Button text="✏️ Edit" onAction="#handleEditUser"
                    style="-fx-background-color: #a0522d;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 8px 16px;
                           -fx-background-radius: 8px;"/>
            <Button text="🗑️ Delete" onAction="#handleDeleteUser"
                    style="-fx-background-color: #8b4513;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 8px 16px;
                           -fx-background-radius: 8px;"/>
            <Button text="🔒 Block/Unblock" onAction="#handleBlockUser"
                    style="-fx-background-color: #d32f2f;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 8px 16px;
                           -fx-background-radius: 8px;"/>
            <Button text="🏠 Home" onAction="#goBackToHome"
                    style="-fx-background-color: #d2691e;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-padding: 8px 16px;
                           -fx-background-radius: 8px;"/>
        </HBox>

        <!-- Logout button -->
        <Button text="🚪 Logout" onAction="#logout"
                style="-fx-background-color: #d32f2f;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-padding: 10 20;"
                AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">
            <effect>
                <DropShadow color="#00000080" radius="5.0" spread="0.1"/>
            </effect>
        </Button>
    </children>

    <!-- Styles -->
    <stylesheets>
        <String fx:value="@style.css" />
    </stylesheets>
</AnchorPane>