<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ArtisteDashboardController"
            stylesheets="@styles.css">

    <top>
        <HBox alignment="CENTER" 
              style="-fx-background-color: #f8f9fa; -fx-padding: 20;">
            <Label text="Tableau de bord Artiste" 
                   styleClass="form-title" />
        </HBox>
    </top>

    <center>
        <TabPane>
            <Tab text="Produits">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Formulaire d'ajout de produit -->
                    <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
                        <Label text="Ajouter un produit" styleClass="form-subtitle"/>
                        <GridPane vgap="10" hgap="10">
                            <Label text="Titre :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            
                            <Label text="Prix :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="prixField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            
                            <Label text="Description :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextArea fx:id="descriptionField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            
                            <Label text="Catégorie :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="categorieComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button text="Ajouter" 
                                    styleClass="btn-primary" 
                                    onAction="#handleAddProduit"/>
                        </HBox>
                    </VBox>

                    <!-- Liste des produits -->
                    <TableView fx:id="produitsTable">
                        <columns>
                            <TableColumn fx:id="titreColumn" text="Titre" prefWidth="200"/>
                            <TableColumn fx:id="prixColumn" text="Prix" prefWidth="100"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Supprimer" 
                                styleClass="btn-danger" 
                                onAction="#handleDeleteProduit"/>
                    </HBox>
                </VBox>
            </Tab>
            
            <Tab text="Catégories">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Formulaire d'ajout de catégorie -->
                    <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
                        <Label text="Ajouter une catégorie" styleClass="form-subtitle"/>
                        <GridPane vgap="10" hgap="10">
                            <Label text="Libellé :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="libelleField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            
                            <Label text="Description :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextArea fx:id="categorieDescriptionArea" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button text="Ajouter" 
                                    styleClass="btn-primary" 
                                    onAction="#handleAddCategorie"/>
                        </HBox>
                    </VBox>

                    <!-- Liste des catégories -->
                    <TableView fx:id="categoriesTable">
                        <columns>
                            <TableColumn fx:id="libelleColumn" text="Libellé" prefWidth="200"/>
                            <TableColumn fx:id="categorieDescriptionColumn" text="Description" prefWidth="300"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Supprimer" 
                                styleClass="btn-danger" 
                                onAction="#handleDeleteCategorie"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" 
              style="-fx-padding: 20;">
            <Button text="Déconnexion" 
                    styleClass="btn-secondary" 
                    onAction="#handleDeconnexion"/>
        </HBox>
    </bottom>

</BorderPane> 