<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminDashboardController"
            stylesheets="@styles.css">

    <top>
        <HBox alignment="CENTER" 
              style="-fx-background-color: #f8f9fa; -fx-padding: 20;">
            <Label text="Tableau de bord Admin" 
                   styleClass="form-title" />
        </HBox>
    </top>

    <center>
        <TabPane>
            <Tab text="Produits">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <TableView fx:id="produitsTable">
                        <columns>
                            <TableColumn fx:id="titreColumn" text="Titre" prefWidth="200"/>
                            <TableColumn fx:id="prixColumn" text="Prix" prefWidth="100"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Supprimer" 
                                styleClass="btn-danger" 
                                onAction="#handleDeleteProduit"/>
                    </HBox>
                </VBox>
            </Tab>
            
            <Tab text="Catégories">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <TableView fx:id="categoriesTable">
                        <columns>
                            <TableColumn fx:id="libelleColumn" text="Libellé" prefWidth="200"/>
                            <TableColumn fx:id="categorieDescriptionColumn" text="Description" prefWidth="300"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Supprimer" 
                                styleClass="btn-danger" 
                                onAction="#handleDeleteCategorie"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" 
              style="-fx-padding: 20;">
            <Button text="Déconnexion" 
                    styleClass="btn-secondary" 
                    onAction="#handleDeconnexion"/>
        </HBox>
    </bottom>

</BorderPane> 